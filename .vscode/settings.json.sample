{
  // Format on save
  "editor.formatOnSave": true,

  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "files.associations": {
    "**/app/assets/styles/*.css": "tailwindcss",
    "firebase.json": "jsonc"
  },

  // Recommended by Tailwind CSS extension
  "editor.quickSuggestions": {
    "strings": "on"
  }
}
